+
+/* -------------------------------------------------------------------------- */
+/* Mobile responsiveness                                                     */
+/* -------------------------------------------------------------------------- */
+
+html {
+  width: 100%;
+  max-width: 100%;
+  overflow-x: hidden;
+  -webkit-text-size-adjust: 100%;
+  text-size-adjust: 100%;
+}
+
+body,
+#root {
+  width: 100%;
+  max-width: 100%;
+  min-width: 0;
+}
+
+button,
+a,
+input,
+select,
+textarea {
+  -webkit-tap-highlight-color: transparent;
+}
+
+@media (max-width: 639px) {
+  body {
+    background-attachment: scroll;
+  }
+
+  /* Evita zoom automático do Safari/iOS ao focar campos. */
+  input,
+  select,
+  textarea {
+    font-size: 16px !important;
+  }
+
+  /* Controles confortáveis para toque sem alterar os botões de ícone pequenos. */
+  button:not([data-slot="checkbox"]),
+  [role="button"] {
+    touch-action: manipulation;
+  }
+
+  /* Mantém conteúdos longos, tabelas e códigos dentro da viewport. */
+  pre,
+  code,
+  table {
+    max-width: 100%;
+  }
+
+  pre {
+    overflow-x: auto;
+  }
+
+  /* Os cards principais ficam menos arredondados no celular e ganham área útil. */
+  .ink-panel {
+    border-radius: 1.15rem;
+  }
+}
+
+/* Safe area do PWA/iPhone. */
+@supports (padding: max(0px)) {
+  body {
+    padding-left: env(safe-area-inset-left);
+    padding-right: env(safe-area-inset-right);
+  }
+}
