# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Servidor: mesmo projeto do frontend.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Chave PRIVADA: criar/bloquear contas e operações de pagamento via servidor.
# Configure também nos secrets da hospedagem; nunca use prefixo VITE_ nesta chave.
SUPABASE_SERVICE_ROLE_KEY=
# Alternativa à chave legacy acima: SUPABASE_SECRET_KEY=sb_secret_...
# Use uma das duas somente no servidor (nunca VITE_).
# Integração Stripe Connect do Lovable (também somente no servidor):
# LOVABLE_API_KEY=
# STRIPE_SANDBOX_API_KEY=
# STRIPE_LIVE_API_KEY=

# Google Drive (somente no servidor; configure também nos secrets da hospedagem)
# Habilite a Google Drive API no projeto Google Cloud desta chave.
GOOGLE_DRIVE_API_KEY=
# Segredo aleatório para assinar o acesso de leitura aos PDFs importados do Drive.
BOOKSYDE_DRIVE_PROXY_SECRET=

# Anúncio intersticial do leitor (opcional)
VITE_READER_AD_IMAGE_URL=https://example.com/anuncio.jpg
VITE_READER_AD_TARGET_URL=https://example.com/oferta
VITE_READER_AD_ALT=Anúncio do patrocinador

# Spring Boot API (Stage 6+)
VITE_API_URL=http://localhost:8080
